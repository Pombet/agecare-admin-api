{
  "version": 2,
  "builds": [{ "src": "api/index.py", "use": "@vercel/python", "config": { "includeFiles": ["frontend-demo/**", "app/static/juegos/**"] } }],
  "routes": [{ "src": "/(.*)", "dest": "api/index.py" }],
  "crons": [{ "path": "/api/v1/billing/internal/cron/billing-cycle", "schedule": "0 12 * * *" }]
}
